@page
@model CarvedRock.WebApp.Pages.Admin.CreateModel
@using CarvedRock.Core

<div class="container py-4">
    <h1 class="h2 mb-1">Create product</h1>
    <p class="text-muted mb-4">Add a new product to the catalog.</p>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Product.Name" class="form-label"></label>
                                <input asp-for="Product.Name" class="form-control" />
                                <span asp-validation-for="Product.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Product.Category" class="form-label"></label>
                                <input asp-for="Product.Category" class="form-control" placeholder="kayak, equip or boots" />
                                <span asp-validation-for="Product.Category" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <partial name="_DescribeDraft" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Product.Description" class="form-label"></label>
                                <textarea asp-for="Product.Description" class="form-control" rows="4"
                                          data-limit="@ProductLimits.MaxDescriptionLength"></textarea>
                                <div class="form-text">
                                    <span id="descriptionCount">0</span> of @ProductLimits.MaxDescriptionLength characters
                                </div>
                                <span asp-validation-for="Product.Description" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Product.Price" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Product.Price" class="form-control" />
                                </div>
                                <span asp-validation-for="Product.Price" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Product.ImgUrl" class="form-label">Image URL</label>
                                <div class="input-group">
                                    <input asp-for="Product.ImgUrl" class="form-control" />
                                    <button type="button" id="randomImage" class="btn btn-outline-secondary"
                                            title="Fill in a random picsum.photos image, like the sample data uses">
                                        Random picsum image
                                    </button>
                                </div>
                                <span asp-validation-for="Product.ImgUrl" class="text-danger"></span>
                                <div>
                                    <img id="imgPreview" alt="Image preview" class="img-thumbnail mt-2" style="max-height: 160px;" hidden />
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-flex align-items-center gap-3">
                            <input type="submit" value="Create" class="btn btn-primary" />
                            <a asp-page="Index">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_ProductFormScripts" />
