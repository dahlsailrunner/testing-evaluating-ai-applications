<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageReference Include="TUnit.Aspire" Version="1.85.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test talks to the running agent over HTTP by resource name; the AppHost is all it needs. -->
    <ProjectReference Include="..\..\CarvedRock.AppHost\CarvedRock.AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="CarvedRock.EvalTests.Utils" />
  </ItemGroup>

</Project>
